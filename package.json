{
  "name": "reeltale",
  "private": true,
  "type": "module",
  "description": "ReelTale monorepo: Expo app (iOS, Android, web), Cloudflare Worker, Supabase schema.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:test": "node --test supabase/tests/*.test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo-asset": "~57.0.20"
  }
}
